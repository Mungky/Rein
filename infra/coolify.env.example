# Isi melalui Environment Variables di Coolify. Ini template, bukan secret produksi.
# Setelah semua nilai wajib diisi: docker compose --env-file infra/coolify.env.example -f infra/docker-compose.yml config --quiet
APP_URL=https://staff.remula.online
LOG_LEVEL=info

# Acak terpisah dengan openssl rand -hex 32. Password PostgreSQL harus URL-safe.
POSTGRES_PASSWORD=
OPENWA_DB_PASSWORD=
AUTH_PEPPER=
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=

# Bootstrap sekali: terminal service app -> node dist/seed-cli.js
# Setelah Admin dibuat, kosongkan SEED_ADMIN_PASSWORD dan redeploy.
SEED_ADMIN_NAME=Admin REIN
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Bucket privat khusus v2; file ada di HOST server, bukan di Git.
GCS_BUCKET=
GCS_KEY_FILE=/data/rein-v2/secrets/gcs-key.json

# Gmail API sebagai kanal cadangan. Akun pengirim dan refresh token harus cocok.
MAIL_PROVIDER=gmail
GMAIL_SENDER=
GMAIL_SENDER_NAME=REIN
GMAIL_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://staff.remula.online/auth/google/callback

# Pin digest image yang sudah diuji sebelum dipakai rutin di produksi.
OPENWA_IMAGE=ghcr.io/rmyndharis/openwa:latest
OPENWA_SESSION_ID=rein
REIN_WA_NUMBER=
