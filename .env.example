# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Supabase PostgreSQL pooled connection)
# Get this from: Supabase Dashboard → Settings → Database → Connection string (pooling mode, port 6543)
# IMPORTANT: use the TRANSACTION pooler (port 6543), NOT session mode (5432) —
# session mode pins 1 of only 15 server slots per client and takes the app down
# with "max clients reached" once dev + backend + bridge + migrations pile up.
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Optional: Alembic migrations run over the session pooler (5432) — safest for DDL
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# FastAPI
API_SECRET_KEY=change-this-in-production
API_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Google OAuth 2.0 (NOT Service Account)
# Get these from: Google Cloud Console → APIs & Services → Credentials
# 1. Create OAuth 2.0 Client ID (Desktop app type)
# 2. Download the JSON credentials file → save as backend/credentials/credentials.json
# 3. The first time you run the app, it will open a browser for OAuth consent
# 4. After consent, tokens are saved to credentials/token.json automatically
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_TOKEN_PATH=credentials/token.json
GOOGLE_CREDENTIALS_PATH=credentials/credentials.json

# Google Drive & Sheets
GOOGLE_DRIVE_ROOT_FOLDER_ID=1rsATPU5-JkOvNXqolzej0BgUFXAb4VHh
GOOGLE_SHEETS_SPREADSHEET_ID=1oZjkzGInjL6a5LxfmD8a8DydpHOb-yeXWom2TfGsBlk
# Separate public-facing index spreadsheet (limited fields, visible to all users)
GOOGLE_SHEETS_PUBLIC_SPREADSHEET_ID=1gBr1lbQNRo-HpFD7evJNL88nbvu8ecyhiFMTmCrMehc

# Ollama (NimBus AI) — running on VPS
# Default: localhost if Ollama is on the same server
# For remote VPS: http://your-vps-ip:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Frontend — development: direct to local backend
# Production (Vercel): set to your domain, e.g. https://rein.co.id
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production only: VPS backend URL used by Vercel rewrites (NOT exposed to browser)
# Set this in Vercel project settings → Environment Variables
# BACKEND_URL=http://YOUR_VPS_IP:8000

# Hardcoded admin (used by db/seed.py)
# The admin login uses the synthetic email <ADMIN_USERNAME>@rein.internal under
# the hood — users only ever type the username.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Administrator