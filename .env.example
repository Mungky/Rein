# Salin ke .env lalu isi. Jangan commit .env. Nilai di bawah hanya contoh.

# --- Aplikasi ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
TZ=Asia/Jakarta
# URL yang dibuka user (dipakai di email & redirect). Dev: Vite di 5173. Prod: https://staff.remula.online
APP_URL=http://localhost:5173
LOG_LEVEL=info
# true jika di belakang reverse proxy (Traefik/Coolify) — IP klien dibaca dari X-Forwarded-For
TRUST_PROXY=false

# --- Database ---------------------------------------------------------------
POSTGRES_PASSWORD=ganti-password-postgres-dev
DATABASE_URL=postgres://rein:ganti-password-postgres-dev@localhost:5432/rein
# Dipakai `pnpm test` untuk test integrasi (database terpisah, dibuat oleh infra/postgres/init)
DATABASE_URL_TEST=postgres://rein:ganti-password-postgres-dev@localhost:5432/rein_test

# --- Auth -------------------------------------------------------------------
# Pepper untuk hash password & PIN (argon2id). Acak ≥ 32 byte, mis. `openssl rand -base64 48`.
# Jangan diganti setelah ada user — semua password jadi tidak cocok.
AUTH_PEPPER=

# Admin pertama yang dibuat `pnpm db:seed` (password dipakai sekali, ganti setelah login)
SEED_ADMIN_NAME=Admin REIN
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@remula.co.id
SEED_ADMIN_PASSWORD=

# --- Login dengan Google (OIDC) ---------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Harus terdaftar di Authorized redirect URI. Prod: https://staff.remula.online/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Email (Gmail API) ------------------------------------------------------
# gmail | null   (null = tulis email ke log, untuk dev/test)
MAIL_PROVIDER=null
GMAIL_SENDER=notifikasi@remula.co.id
GMAIL_SENDER_NAME=REIN
# Diisi dari `pnpm gmail:token` (scope gmail.send, akun pengirim)
GMAIL_REFRESH_TOKEN=

# --- Storage (Google Cloud Storage) -----------------------------------------
# gcs | local
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
GCS_BUCKET=rein-attachments
GCS_BACKUP_BUCKET=rein-backup
# Path key JSON service account rein-storage (di-ignore git)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcs-key.json

# --- WhatsApp (OpenWA) ------------------------------------------------------
# Kosong = otomatis (openwa bila OPENWA_URL & OPENWA_API_KEY terisi). `null` = hanya dicatat di log.
WA_PROVIDER=
# Dev: server di host → http://localhost:2785. Prod (jaringan Docker): http://openwa:2785
OPENWA_URL=http://localhost:2785
# ≥ 32 karakter acak. Dipakai juga sebagai API_MASTER_KEY container OpenWA.
OPENWA_API_KEY=
# Nama sesi di OpenWA (dibuat otomatis saat server start)
OPENWA_SESSION_ID=rein
# Secret HMAC webhook OpenWA → REIN (≥ 16 karakter acak)
OPENWA_WEBHOOK_SECRET=
# URL REIN yang dipanggil OpenWA. Dev: container → host. Prod: http://app:3000/webhooks/openwa
OPENWA_WEBHOOK_URL=http://host.docker.internal:3000/webhooks/openwa
OPENWA_DB_PASSWORD=ganti-password-openwa-dev
# Opsional: pin image OpenWA tertentu
# OPENWA_IMAGE=ghcr.io/rmyndharis/openwa:latest
# Opsional: nomor WA REIN untuk informasi Admin. OTP memakai sesi OpenWA, tanpa tautan wa.me.
REIN_WA_NUMBER=
