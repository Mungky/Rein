{
  "name": "rein",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @rein/web --filter @rein/server dev",
    "build": "pnpm --filter @rein/web build && pnpm --filter @rein/server build",
    "start": "pnpm --filter @rein/server start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "db:generate": "pnpm --filter @rein/server db:generate",
    "db:migrate": "pnpm --filter @rein/server db:migrate",
    "db:seed": "pnpm --filter @rein/server db:seed",
    "gmail:token": "pnpm --filter @rein/server gmail:token"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
