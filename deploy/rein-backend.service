[Unit]
Description=REIN Backend API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/rein
EnvironmentFile=/opt/rein/.env
ExecStart=/opt/rein/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rein-backend

[Install]
WantedBy=multi-user.target
