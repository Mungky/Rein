# ============================================================
#  config.env — kredensial pemancar R-Net (RAHASIA)
# ============================================================
# Cara pakai:
#   1. Salin file ini menjadi  config.env  (tanpa ".example")
#   2. Isi dua nilai di bawah dengan data proyek Supabase REIN
#   3. JANGAN pernah kirim file config.env ke Git / orang lain —
#      SUPABASE_SERVICE_KEY = kunci akses penuh ke database.
#
# Installer (install.ps1) akan membuat file ini otomatis dan
# menanyakan kedua nilai; isi manual hanya jika perlu.
# ------------------------------------------------------------

# Alamat proyek Supabase, contoh: https://abcdefgh.supabase.co
# (di dashboard Supabase: Project Settings > Data API > Project URL)
SUPABASE_URL=GANTI_DENGAN_URL_SUPABASE

# Service role key (Project Settings > API Keys > service_role, "secret").
# Bukan anon key. Dipakai untuk meng-update alamat stream di database.
SUPABASE_SERVICE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY

# ------------------------------------------------------------
# Nama stream yang alamatnya di-update oleh MESIN INI.
# ------------------------------------------------------------
# WAJIB diisi kalau ada LEBIH DARI SATU sumber siaran (mis. PC server
# + laptop). Tanpa ini, tiap mesin akan menimpa alamat SEMUA stream —
# jadi saling tabrak dan stream lain mati.
#
# Isi PERSIS sama dengan nama di R-Net > Kelola Stream.
# Contoh di PC server:  STREAM_NAME=Line Server
# Contoh di laptop:     STREAM_NAME=Line Laptop
#
# Kosongkan HANYA jika benar-benar cuma ada satu sumber siaran.
STREAM_NAME=

# (opsional) Path MediaMTX untuk stream ini. Default "scada".
# Ubah HANYA jika Anda menjalankan >1 OBS di mesin yang sama DAN sudah
# menambahkan path baru di mediamtx.yml (bagian authInternalUsers + paths).
STREAM_PATH=scada

# ------------------------------------------------------------
# Sumber VNC (komponen [5] installer) — PC yang layarnya
# dipantulkan ke channel R-Net jenis "VNC (Layar PC)".
# ------------------------------------------------------------
# Nomor channel VNC milik PC INI; saklar start-vnc meng-update
# alamat channel itu tiap dinyalakan. WAJIB diisi kalau ada lebih
# dari satu PC sumber VNC (kosong = menimpa SEMUA channel VNC).
VNC_CHANNEL=

# Password VIEW-ONLY TightVNC (maks 8 karakter). Ikut dituliskan
# ke config channel supaya penonton auto-connect. JANGAN isi
# password kontrol/maintenance di sini.
VNC_VIEW_PASSWORD=
