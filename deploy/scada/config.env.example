# ============================================================
#  config.env — kredensial pemancar R-Net (RAHASIA)
# ============================================================
# Cara pakai:
#   1. Salin file ini menjadi  config.env  (tanpa ".example")
#   2. Isi dua nilai di bawah dengan data proyek Supabase REIN
#   3. JANGAN pernah kirim file config.env ke Git / orang lain —
#      SUPABASE_SERVICE_KEY = kunci akses penuh ke database.
#
# Installer (install.ps1) akan membuat file ini otomatis dan
# menanyakan kedua nilai; isi manual hanya jika perlu.
# ------------------------------------------------------------

# Alamat proyek Supabase, contoh: https://abcdefgh.supabase.co
# (di dashboard Supabase: Project Settings > Data API > Project URL)
SUPABASE_URL=GANTI_DENGAN_URL_SUPABASE

# Service role key (Project Settings > API Keys > service_role, "secret").
# Bukan anon key. Dipakai untuk meng-update alamat stream di database.
SUPABASE_SERVICE_KEY=GANTI_DENGAN_SERVICE_ROLE_KEY
