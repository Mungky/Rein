# R-Net MQTT bridge — salin file ini menjadi ".env" lalu isi DATABASE_URL.
# Semua konfigurasi lain (site, broker, topik) diatur dari frontend R-Net,
# BUKAN di sini.

# Koneksi ke Supabase Postgres (pooler). Ambil dari Supabase:
#   Project Settings → Database → Connection string → URI (mode: Session).
# Gunakan koneksi pooler port 5432.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Opsional — biarkan default kalau tidak yakin:
# FLUSH_INTERVAL_S=60     # seberapa sering nilai ditulis ke database (detik)
# CONFIG_REFRESH_S=30     # seberapa sering baca ulang daftar site/topik (detik)
# LOG_LEVEL=INFO          # DEBUG untuk melihat tiap pesan yang masuk
