# ============================================================
#  config.env — SATU file untuk semua kredensial PC ini (RAHASIA)
# ============================================================
# Cara pakai:
#   1. Installer (install.bat) membuat file ini otomatis dan menanyakan
#      nilai untuk paket yang dipilih. Edit manual hanya kalau perlu.
#   2. JANGAN pernah kirim file config.env ke Git / chat / orang lain.
#
# Baris diawali # = komentar. Format: KUNCI=nilai (tanpa spasi di kunci).
# ------------------------------------------------------------

# ============================================================
# [UMUM]
# ============================================================
# Label PC/site ini — dipakai di pesan-pesan saklar saja.
SITE_NAME=

# ============================================================
# [TUNNEL] — pintu keluar internet (dipakai paket STREAM & MIRROR)
# ============================================================
# MODE PRODUKSI (disarankan): named tunnel Cloudflare dengan domain sendiri.
# Buat sekali di dashboard Cloudflare (lihat docs/PANDUAN-TUNNEL.md), salin
# token-nya ke sini. Alamat stream/mirror jadi PERMANEN — diisi sekali di
# R-Net > Kelola Screen, tidak berubah-ubah tiap start.
TUNNEL_TOKEN=

# Hostname publik yang kamu atur di dashboard (untuk ditampilkan saklar
# sebagai pengingat alamat; boleh dikosongkan).
#   STREAM_HOSTNAME → menunjuk ke http://localhost:8888
#   MIRROR_HOSTNAME → menunjuk ke http://localhost:6080
# Contoh: stream-pabrik1.remula-inti.com
STREAM_HOSTNAME=
MIRROR_HOSTNAME=

# ============================================================
# [STREAM] — siaran layar/HMI (OBS → MediaMTX → tunnel)
# ============================================================
# Path MediaMTX untuk stream ini (default scada). Ubah HANYA jika menjalankan
# >1 OBS di PC yang sama DAN sudah menambah path di mediamtx\mediamtx.yml.
STREAM_PATH=scada

# ============================================================
# [MIRROR] — spion layar PC ini (TightVNC view-only lewat tunnel)
# ============================================================
# Password VIEW-ONLY TightVNC (maks 8 karakter). Ikut dituliskan ke sumber
# VNC di R-Net supaya penonton auto-connect. JANGAN isi password kontrol.
VNC_VIEW_PASSWORD=

# ============================================================
# [DATA] — data sensor (Mosquitto + Node-RED + bridge)
# ============================================================
# Alamat database R-Net untuk BRIDGE (kurir broker → database cloud).
# Format: postgresql://user:password@host:6543/postgres
# (Supabase: Project Settings > Database > Connection string, transaction
# pooler port 6543.)
DATABASE_URL=

# Catatan: akun broker MQTT TIDAK di sini — dikelola "Pengaturan MQTT.bat"
# (file mosquitto\passwd), dan bridge membaca daftar broker dari tabel Site
# di R-Net (tab Data > Kelola Site).

# ============================================================
# [MODE TES] — hanya dipakai kalau TUNNEL_TOKEN kosong
# ============================================================
# Tanpa token, saklar memakai Quick Tunnel (URL acak baru tiap start, untuk
# pengetesan). Supaya alamat barunya tertulis otomatis ke R-Net, isi
# kredensial Supabase di bawah. Di MODE PRODUKSI ketiganya TIDAK diperlukan
# dan sebaiknya dikosongkan (service key = kunci akses penuh database).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Nama stream / sumber VNC milik MESIN INI (harus PERSIS sama dengan nama di
# R-Net > Kelola Screen). Wajib diisi kalau sumbernya lebih dari satu mesin.
STREAM_NAME=
VNC_SOURCE=
