# ============================================================
#  config.env — SATU file untuk semua kredensial PC ini (RAHASIA)
# ============================================================
# Cara pakai:
#   1. Installer (install.bat) membuat file ini otomatis dan menanyakan
#      nilai untuk paket yang dipilih. Edit manual hanya kalau perlu.
#   2. JANGAN pernah kirim file config.env ke Git / chat / orang lain.
#
# Baris diawali # = komentar. Format: KUNCI=nilai (tanpa spasi di kunci).
# ------------------------------------------------------------

# ============================================================
# [UMUM]
# ============================================================
# Label PC/site ini — dipakai di pesan-pesan saklar saja.
SITE_NAME=

# ============================================================
# [TUNNEL] — pintu keluar internet (dipakai paket STREAM & MIRROR)
# ============================================================
# Named tunnel Cloudflare dengan domain sendiri. Dibuat sekali di dashboard
# Cloudflare (lihat docs/PANDUAN-TUNNEL.md), lalu tokennya disalin ke sini.
# Alamat stream/mirror jadi PERMANEN — diisi sekali di R-Net > Kelola Screen,
# tidak berubah tiap start.
#
# TANPA token ini, stream/mirror hanya hidup di dalam PC ini dan TIDAK AKAN
# muncul di R-Net.
TUNNEL_TOKEN=

# Hostname publik yang kamu daftarkan di dashboard Cloudflare. Saklar memakai
# ini untuk mencetak alamat lengkap yang tinggal ditempel ke R-Net.
#   STREAM_HOSTNAME → arahkan ke http://localhost:8888
#   MIRROR_HOSTNAME → arahkan ke http://localhost:6080
# Tulis hostname saja, tanpa https:// dan tanpa garis miring.
# Contoh: stream-pabrik1.remula-inti.com
STREAM_HOSTNAME=
MIRROR_HOSTNAME=

# ============================================================
# [STREAM] — siaran layar/HMI (OBS → MediaMTX → tunnel)
# ============================================================
# Path MediaMTX untuk stream ini (default scada). Ubah HANYA jika menjalankan
# >1 OBS di PC yang sama DAN sudah menambah path di mediamtx\mediamtx.yml.
STREAM_PATH=scada

# ============================================================
# [MIRROR] — spion layar PC ini (TightVNC view-only lewat tunnel)
# ============================================================
# Password VIEW-ONLY TightVNC (maks 8 karakter). Nilai yang sama diisikan ke
# sumber VNC di R-Net supaya penonton auto-connect. JANGAN isi password kontrol.
VNC_VIEW_PASSWORD=

# ============================================================
# [DATA] — data sensor (Node-RED + bridge)
# ============================================================
# Broker MQTT ada di VPS, TIDAK dipasang di PC ini.
#
# Alamat database R-Net untuk BRIDGE (kurir broker → database cloud).
# Format: postgresql://user:password@host:6543/postgres
# (Supabase: Project Settings > Database > Connection string, transaction
# pooler port 6543.)
DATABASE_URL=

# Site (plant) mana yang jadi tanggung jawab PC INI.
#
# Isi dengan ID site dari R-Net > Data > Kelola Site (salin kolom ID-nya).
# Boleh lebih dari satu, dipisah koma — TANPA spasi.
#   Contoh: SITE_ID=3f1c2b90-7a41-4d2e-9c88-1b5e6a0d4f22
#
# KOSONG = PC ini menangani SEMUA plant yang aktif. Itu benar selama Anda baru
# punya satu plant. Begitu ada plant kedua, WAJIB diisi: kalau tidak, setiap PC
# lapangan akan menyambung ke broker SEMUA plant, menulis data SEMUA plant, dan
# menyimpan password broker plant lain di harddisknya. (Temuan audit D-4.)
SITE_ID=

# OPSIONAL — pelacak error Sentry untuk bridge. Pakai DSN yang sama dengan
# backend (dibuat di sentry.io, lihat .env.example repo bagian SENTRY_DSN)
# atau biarkan kosong. Butuh `pip install sentry-sdk` sekali di PC ini.
SENTRY_DSN=

# Alamat broker VPS — CATATAN saja, untuk menyetel node MQTT di Node-RED.
# Tidak dibaca skrip mana pun: bridge mengambil daftar broker (termasuk
# passwordnya) dari R-Net > Data > Kelola Site. Jangan tulis password di sini.
# Port 8883 = MQTT dengan TLS (wajib untuk broker VPS; 1883 di VPS hanya
# terbuka dari localhost VPS itu sendiri). Di Node-RED: centang "Use TLS".
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
