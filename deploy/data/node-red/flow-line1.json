        "type": "function",
        "z": "pabrik1",
        "name": "Tekanan Boiler 1 (bar)",
        "func": "if (flow.get('bisu') === true) {\n    node.status({fill:'grey', shape:'ring', text:'BISU — tidak mengirim'});\n    return null;\n}\nlet v = 6 + 0.5 * Math.sin(Date.now() / 90000) + (Math.random() - 0.5) * 0.3;\nv = Math.round(v * 100) / 100;\nmsg.payload = { value: v };\nnode.status({fill:'green', shape:'dot', text: v + ' bar'});\nreturn msg;",
        "outputs": 1,
        "timeout": "",
