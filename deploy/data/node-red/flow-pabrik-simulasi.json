  {
    "id": "fn_level",
    "type": "function",
    "z": "pabrik1",
    "name": "Level Tangki 1 (%)",
    "func": "if (flow.get('bisu') === true) {\n    node.status({fill:'grey', shape:'ring', text:'BISU — tidak mengirim'});\n    return null;\n}\nlet v = 55 + 10 * Math.sin(Date.now() / 300000) + (Math.random() - 0.5) * 2;\nv = Math.max(0, Math.min(100, Math.round(v * 10) / 10));\nmsg.payload = { value: v };\nnode.status({fill:'green', shape:'dot', text: v + ' %'});\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
