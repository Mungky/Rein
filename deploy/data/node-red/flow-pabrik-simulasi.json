  {
    "id": "inj_temp",
    "type": "inject",
    "z": "pabrik1",
    "name": "tiap 2 detik",
    "props": [{ "p": "payload" }],
    "repeat": "2",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 120,
    "wires": [["fn_temp"]]
  },
  {
    "id": "fn_temp",
    "type": "function",
    "z": "pabrik1",
    "name": "Suhu Boiler 1 (°C)",
    "func": "if (flow.get('bisu') === true) {\n    node.status({fill:'grey', shape:'ring', text:'BISU — tidak mengirim'});\n    return null;\n}\nconst mode = flow.get('mode') || 'normal';\nlet v = 70 + 3 * Math.sin(Date.now() / 60000) + (Math.random() - 0.5) * 2;\nif (mode === 'gila') v = 92 + Math.random() * 4;\nv = Math.round(v * 10) / 10;\nmsg.payload = { value: v };\nnode.status({fill: mode === 'gila' ? 'red' : 'green', shape:'dot', text: v + ' °C'});\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 120,
    "wires": [["out_temp"]]
  },
  {
    "id": "out_temp",
    "type": "mqtt out",
    "z": "pabrik1",
    "name": "",
    "topic": "rnet/demo/boiler1/temperature",
    "qos": "0",
    "retain": "",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker_rnet",
    "x": 620,
    "y": 120,
    "wires": []
  },
