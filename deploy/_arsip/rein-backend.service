[Unit]
Description=REIN Backend API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/rein
EnvironmentFile=/opt/rein/.env
# --proxy-headers + trusting only the local reverse proxy (127.0.0.1) makes the
# rate limiter read the real client IP from X-Forwarded-For instead of the
# proxy's own IP (security S-2). Safe because the app binds to localhost only,
# so the header can't be spoofed from the public internet (S-3).
ExecStart=/opt/rein/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rein-backend

[Install]
WantedBy=multi-user.target
